<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:ctrl="clr-namespace:ApoFisher.Controls"
		x:DataType="ctrl:InventorySlotControl"
		>
	<Design.PreviewWith>
		<ctrl:InventorySlotControl/>
	</Design.PreviewWith>

	<Style Selector="ctrl|InventorySlotControl">
		<Setter Property="Template">
			<ControlTemplate>
				<Border Name="ItemSlot">
					<!--
					<Border.ContextMenu>
						<ContextMenu>
							<MenuItem Header="Equip" Command="{TemplateBinding Equip}"/>
							<MenuItem Header="Discard" Command="{TemplateBinding Discard}"/>
						</ContextMenu>
					</Border.ContextMenu>
					-->
					<Canvas>
						<Image		Source="{TemplateBinding SlotBackground}"
									Width="{TemplateBinding SlotBackgroundSize}"	Height="{TemplateBinding SlotBackgroundSize}"
									/>
						<!-- <Image		Source="{TemplateBinding ItemIcon}"
									Width="{TemplateBinding ItemIconSize}"			Height="{TemplateBinding ItemIconSize}"
									Canvas.Top="{TemplateBinding CanvasOffset}"		Canvas.Left="{TemplateBinding CanvasOffset}"
									/> -->
						<!-- <TextBlock	Text="{TemplateBinding ItemQuantity}"		
									IsVisible="{TemplateBinding Visibility}"
									Canvas.Bottom="{TemplateBinding CanvasOffset}"	Canvas.Right="{TemplateBinding CanvasOffset}"																					
									/> -->
					</Canvas>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>
</Styles>