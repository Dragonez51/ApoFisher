<UserControl xmlns="https://github.com/avaloniaui"		
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:ApoFisher.ViewModels"
			 x:Class="ApoFisher.Views.TraverseView"
             x:DataType="vm:TraverseViewModel"
			 >
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
        <ContentControl Content="{Binding Map}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Zoom In" Command="{Binding Map.ZoomIn}"/>
            <Button HorizontalAlignment="Center" Command="{Binding RouteVillage}">BACK</Button>
            <Button Content="Zoom Out" Command="{Binding Map.ZoomOut}"/>
        </StackPanel>
    </StackPanel>
</UserControl>