<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ApoFisher.ViewModels"
		xmlns:ctrl="clr-namespace:ApoFisher.Controls"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
        x:Class="ApoFisher.Views.MainView"
        x:CompileBindings="True"
		x:DataType="vm:MainViewModel"
		Title="ApoFisher by Dragonez51"
		Width="300"
		Height="600"
		MinHeight="600"
		MinWidth="1200"
		WindowStartupLocation="CenterOwner"
		>
	<Window.DataContext>
		<vm:MainViewModel/>
	</Window.DataContext>
	
	<Panel>
		<TextBlock TextWrapping="Wrap" Text="{Binding Bgtext}"></TextBlock>	
		<Grid ColumnDefinitions="75, *" >
			<StackPanel Grid.Column="0" Orientation="Vertical" Background="#c0002a20">
				<Border BorderBrush="Red" BorderThickness="3" CornerRadius="8" HorizontalAlignment="Center" Width="55" Height="55" Margin="0,15,0,0">
					<Button Background="#8aff0000">
						<Image Source="{Binding MenuLogo}" Width="64" Height="64"/>
					</Button>
				</Border>
			</StackPanel>	
			<StackPanel Grid.Column="1" Orientation="Horizontal" Height="75" VerticalAlignment="Top" Background="#c0002a20">
				
			</StackPanel>	
		</Grid>
	</Panel>
</Window>