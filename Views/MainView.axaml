<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ApoFisher.ViewModels"
		xmlns:ctrl="clr-namespace:ApoFisher.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ApoFisher.Views.MainView"
        x:CompileBindings="True"
		x:DataType="vm:MainViewModel"
		Title="ApoFisher by Dragonez51"
		Width="1200"
		Height="600"
		MinHeight="600"
		MinWidth="1200"
		WindowStartupLocation="CenterOwner"
		>
	<Window.DataContext>
		<vm:MainViewModel/>
	</Window.DataContext>
	
	<Grid ColumnDefinitions="2*, 8*">
		<Grid Column="0" RowDefinitions="2*, 8*" Background="#444">
			<Image  Grid.Row="0" Source="{Binding AppLogo}" Width="96" Height="96"/>
			<StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
				<ctrl:RoutingButton RoutingName="Map"/>
				<ctrl:RoutingButton RoutingName="Inventory"/>
				<ctrl:RoutingButton RoutingName="Glossary"/>
				<ctrl:RoutingButton RoutingName="Settings"/>
			</StackPanel>
		</Grid>
		<UserControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
	</Grid>
</Window>