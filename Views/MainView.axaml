<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ApoFisher.ViewModels"
		xmlns:ctrl="clr-namespace:ApoFisher.Controls"
        x:Class="ApoFisher.Views.MainView"
        x:CompileBindings="True"
		x:DataType="vm:MainViewModel"
		Title="ApoFisher"
		MinWidth="1075"
		MinHeight="600"
		WindowStartupLocation="CenterOwner"
		>
	<Window.DataContext>
		<vm:MainViewModel/>
	</Window.DataContext>
	
	<Panel>
		<!--
			Grid Columns: 
		 		1. Icons left 
		 		2. Side Views Panel 
		 		3. Gameplay space 
		 		4. Work station
		-->
		<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="75"/>
			<ColumnDefinition Width="{Binding PlayerViewCD}"/>
			<ColumnDefinition Width="*"/>
			<!-- <ColumnDefinition Width="{Binding WorkspaceViewCD}"/> -->
		</Grid.ColumnDefinitions>

			<Grid Grid.Column="0" Grid.RowDefinitions="*,*" Background="#c0002a20">
				<StackPanel Grid.Row="0" Orientation="Vertical">
					<ctrl:RoutingButton RoutingName="Inventory"/>
					<ctrl:RoutingButton RoutingName="Statistics"/>
				</StackPanel>
				<StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Bottom">	
					<ctrl:RoutingButton RoutingName="Glossary"/>
					<ctrl:RoutingButton RoutingName="Settings"/>
				</StackPanel>
			</Grid>
			<UserControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
			<UserControl Grid.Column="2" Content="{Binding CurrentLocation}"/>
			<!-- <UserControl Grud.Column="3" Content="{Binding CurrentWorkStation}"/>	 -->
			 <!-- <Rectangle Grid.Column="3" Fill="#aa0"/> -->
			 <!-- <ContentControl Grid.Column="3" Content="{Binding WorkspaceContent}"/> -->
		</Grid>
		<UserControl IsVisible="{Binding SettingsVisible}">
			<vm:SettingsViewModel/>
		</UserControl>
	</Panel>
</Window>