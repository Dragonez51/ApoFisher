<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:ApoFisher.ViewModels"
			 xmlns:v="clr-namespace:ApoFisher.Views"
			 xmlns:ctrl="clr-namespace:ApoFisher.Controls"
			 x:Class="ApoFisher.Views.InventoryListView"
			 x:DataType="vm:InventoryListViewModel"
			 >
	<Border>
		<ItemsControl ItemsSource="{Binding InventorySlots}" Background="#0fa" Padding="10" BorderThickness="3" BorderBrush="BlueViolet">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel ItemsAlignment="Center"
							   ItemWidth="{Binding SlotBackgroundSize}"
							   ItemHeight="{Binding SlotBackgroundSize}"
							   >
					</WrapPanel>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border>		
						<ctrl:InventorySlotControl ItemIcon				="{Binding Icon}" 
												   ItemQuantity			="{Binding Quantity}"
												   SlotID				="{Binding SlotID}"
												   Visibility			="{Binding Visibility}"
												   ItemIconSize			="{Binding $parent[v:InventoryListView].((vm:InventoryListViewModel)DataContext).ItemIconSize}"
												   SlotBackground		="{Binding $parent[v:InventoryListView].((vm:InventoryListViewModel)DataContext).SlotBackground}"
												   SlotBackgroundSize	="{Binding $parent[v:InventoryListView].((vm:InventoryListViewModel)DataContext).SlotBackgroundSize}"
												   CanvasOffset			="{Binding $parent[v:InventoryListView].((vm:InventoryListViewModel)DataContext).CanvasOffset}"
												   Equip				="{Binding $parent[v:InventoryListView].((vm:InventoryListViewModel)DataContext).EquipCommand}"
												   Discard				="{Binding $parent[v:InventoryListView].((vm:InventoryListViewModel)DataContext).DiscardCommand}"
												   />
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Border>
</UserControl>