<UserControl xmlns="https://github.com/avaloniaui"		
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ds="using:ApoFisher.DataStructures"
			 xmlns:vm="using:ApoFisher.ViewModels"
			 x:Class="ApoFisher.Views.VillageView"
			 x:DataType="vm:VillageViewModel"
			 >
	<StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Blue" Height="600" Width="200">
		<Border BorderBrush="AliceBlue" Background="BurlyWood" BorderThickness="2" Margin="15" CornerRadius="4"><Button HorizontalAlignment="Stretch" Command="{Binding RouteTraverse}"><Label HorizontalAlignment="Center">LAKE</Label></Button></Border> 
		<Border BorderBrush="AliceBlue" Background="BurlyWood" BorderThickness="2" Margin="15" CornerRadius="4"><Button HorizontalAlignment="Stretch"><Label HorizontalAlignment="Center">BRIEFING</Label></Button></Border>	
		<Border BorderBrush="AliceBlue" Background="BurlyWood" BorderThickness="2" Margin="15" CornerRadius="4"><Button HorizontalAlignment="Stretch"><Label HorizontalAlignment="Center">MARKET</Label></Button></Border>	
		<Canvas Width="200" Height="400">
			<ds:Hexagon Size="20.0" X="0" Y="0" StrokeThickness="3" Fill="#f00" HorizontalAlignment="Center"/>
			<ds:Hexagon Size="20.0" X="1" Y="0" StrokeThickness="3" Fill="#f00" HorizontalAlignment="Center"/>
			<ds:Hexagon Size="20.0" X="2" Y="0" StrokeThickness="3" Fill="#f00" HorizontalAlignment="Center"/>
			<ds:Hexagon Size="20.0" X="3" Y="0" StrokeThickness="3" Fill="#f00" HorizontalAlignment="Center"/>
			<ds:Hexagon Size="20.0" X="4" Y="0" StrokeThickness="3" Fill="#f00" HorizontalAlignment="Center"/>
			<ds:Hexagon Size="20.0" X="0" Y="1" StrokeThickness="3" Fill="#f00" HorizontalAlignment="Center"/>
			<ds:Hexagon Size="20.0" X="1" Y="1" StrokeThickness="3" Fill="#f00" HorizontalAlignment="Center"/>
			<ds:Hexagon Size="20.0" X="2" Y="1" StrokeThickness="3" Fill="#f00" HorizontalAlignment="Center"/>
			<ds:Hexagon Size="20.0" X="3" Y="1" StrokeThickness="3" Fill="#f00" HorizontalAlignment="Center"/>
			<ds:Hexagon Size="20.0" X="4" Y="1" StrokeThickness="3" Fill="#f00" HorizontalAlignment="Center"/>
	</Canvas>
	</StackPanel>
</UserControl>