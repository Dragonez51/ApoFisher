<UserControl xmlns="https://github.com/avaloniaui"		
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:ApoFisher.ViewModels"
			 x:Class="ApoFisher.Views.LakeView"
             x:DataType="vm:LakeViewModel"
			 >
    <StackPanel Orientation="Vertical" Spacing="20" Margin="20">
        <Border HorizontalAlignment="Center">
            <ContentPage Content="{Binding FishingViewport}"/>
        </Border>
        <Border BorderBrush="AliceBlue" BorderThickness="3" CornerRadius="5" HorizontalAlignment="Center">
            <Button Background="#0aa" Command="{Binding StartFishing}" Content="Fihh"/>
        </Border>
    </StackPanel>
</UserControl>