<UserControl xmlns="https://github.com/avaloniaui"		
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="clr-namespace:ApoFisher.ViewModels"
             xmlns:ctrl="clr-namespace:ApoFisher.Controls"
			 x:Class="ApoFisher.Views.LakeView"
             x:DataType="vm:LakeViewModel"
			 >
    <StackPanel Orientation="Vertical" Spacing="20" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border HorizontalAlignment="Center">
            <Canvas Background="#a00" Width="{Binding ViewportWidth}" Height="{Binding ViewportHeight}">
                <Rectangle Canvas.Left="{Binding BouncerOffset}" Fill="#0a0" Width="{Binding BouncerWidth}" Height="{Binding BouncerHeight}"/>
                <Rectangle Canvas.Left="{Binding CursorOffset}" Fill="#ff0" Width="{Binding CursorWidth}" Height="{Binding CursorHeight}"/>
            </Canvas>
        </Border>
        <Border BorderBrush="AliceBlue" BorderThickness="3" CornerRadius="5" HorizontalAlignment="Center">
            <ProgressBar Value="{Binding Progress}" Maximum="{Binding ProgressMax}"/>
        </Border>
        <Border BorderBrush="AliceBlue" BorderThickness="3" CornerRadius="5" HorizontalAlignment="Center">
            <Button Background="#0aa" Command="{Binding StartFishing}" Content="START"/>
        </Border>
        <Border BorderBrush="AliceBlue" BorderThickness="3" CornerRadius="5" HorizontalAlignment="Center">
            <Button Background="#0aa" Command="{Binding BounceFish}" Content="FISH" Width="150" Height="75" FontSize="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Border>
        <Border BorderBrush="AliceBlue" BorderThickness="3" CornerRadius="5" HorizontalAlignment="Center">
            <ctrl:RoutingButton RoutingName="Traverse"/>
        </Border>
    </StackPanel>
</UserControl>